# copy to .env next to docker-compose.yml (production / Docker); backend/.env.example is for local development
# REQUIRED: password of the MySQL root user
MYSQL_ROOT_PASSWORD=
# REQUIRED: a long random string (at least 16 characters):  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# the address people open the system at (comma-separated if more than one)
CORS_ORIGINS=http://localhost
# port of the web server on this machine
WEB_PORT=80
