# copy to backend/.env for local development (docker-compose uses the .env next to docker-compose.yml)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/soldier-management?charset=utf8mb4
# PostgreSQL also works: postgresql+psycopg://user:password@localhost:5432/soldier-management
# REQUIRED: a long random string; the API refuses to start with a placeholder or one shorter than 16 characters.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
STORAGE_DIR=storage
CORS_ORIGINS=http://localhost:5173
# largest upload (photo / attachment), in MB
MAX_UPLOAD_MB=20
# failed logins before an account is locked, and for how long
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
